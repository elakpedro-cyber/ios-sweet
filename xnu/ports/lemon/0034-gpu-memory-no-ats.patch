+static uint64_t
+lm_walk(vm_offset_t memory, uint64_t pa, uint32_t va)
+{
+	uint64_t table = pa;
+	static const unsigned shifts[] = {30,21,12};
+	for (unsigned level = 0; level < 3; level++) {
+		if (table < pa || table >= pa + 12288 || (table & 4095)) return 1;
+		uint64_t pte = ((uint64_t *)(memory + table - pa))[(va >> shifts[level]) & 511];
+		if ((pte & 3) != 3) return 1;
+		table = pte & 0x0000fffffffff000ull;
+	}
+	return table;
+}
