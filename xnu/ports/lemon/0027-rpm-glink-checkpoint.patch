+/* SM6115 RPM GLINK handoff checkpoint. Read-only; no rail votes or FIFO writes.
+ * Layout: Linux drivers/rpmsg/qcom_glink_rpm.c; addresses: live lemon FDT.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET) && defined(LEMON_4K)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void lemon_rpm_snapshot(void);
+
+#define LR_PA 0x045f0000u
+#define LR_SIZE 0x7000u
+#define LR_TOC (LR_SIZE - 256u)
+#define LR_TX 0x61703272u
+#define LR_RX 0x72326170u
+
+struct lr_pipe { unsigned offset, size; };
+
+static uint32_t
+lr_read(vm_offset_t base, unsigned offset)
+{
+	uint32_t value = *(volatile uint32_t *)(base + offset);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+static bool
+lr_parse(vm_offset_t base, struct lr_pipe *tx, struct lr_pipe *rx)
+{
+	uint32_t magic = lr_read(base, LR_TOC), count = lr_read(base, LR_TOC + 4);
+	printf("LEMON RPM: GLINK toc=%#x entries=%u\n", magic, count);
+	if (magic != 0x67727430u || !count || count > 20) return false;
+	tx->size = rx->size = 0;
+	for (unsigned i = 0; i < count; i++) {
+		unsigned entry = LR_TOC + 8 + i * 12;
+		uint32_t id = lr_read(base, entry);
+		if (id != LR_TX && id != LR_RX) continue;
+		unsigned offset = lr_read(base, entry + 4), size = lr_read(base, entry + 8);
+		/* Descriptor tail/head precede size bytes of FIFO. No TOC overlap. */
+		if ((offset & 3) || (size & 7) || size < 16 ||
+		    offset > LR_TOC - 8 || size > LR_TOC - 8 - offset) return false;
+		struct lr_pipe *pipe = id == LR_TX ? tx : rx;
+		if (pipe->size) return false;
+		pipe->offset = offset;
+		pipe->size = size;
+	}
+	if (!tx->size || !rx->size) return false;
+	if (tx->offset < rx->offset + 8 + rx->size &&
+	    rx->offset < tx->offset + 8 + tx->size) return false;
+	return true;
+}
+
+static bool
+lr_snapshot_pipe(vm_offset_t base, const char *name, struct lr_pipe pipe)
+{
+	/* A remote producer can move head: this is a diagnostic, not ownership. */
+	unsigned tail = lr_read(base, pipe.offset), head = lr_read(base, pipe.offset + 4);
+	printf("LEMON RPM: %s offset=%#x size=%#x tail=%#x head=%#x\n",
+	    name, pipe.offset, pipe.size, tail, head);
+	if (tail >= pipe.size || head >= pipe.size || ((tail | head) & 7)) return false;
+	unsigned available = head >= tail ? head - tail : pipe.size - tail + head;
+	/* At most the first64 pending bytes; do not advance pointers or ACK. */
+	for (unsigned i = 0; i < available && i < 64; i += 8) {
+		unsigned pos = (tail + i) % pipe.size;
+		printf("LEMON RPM: %s pending+%u %08x %08x\n", name, i,
+		    lr_read(base, pipe.offset + 8 + pos),
+		    lr_read(base, pipe.offset + 12 + pos));
+	}
+	return true;
+}
+
+void
+lemon_rpm_snapshot(void)
+{
+	vm_offset_t base = ml_io_map(LR_PA, LR_SIZE);
+	if (!base) {
+		printf("LEMON RPM: mapping failed; no power requests\n");
+		return;
+	}
+	struct lr_pipe tx = {0}, rx = {0};
+	if (!lr_parse(base, &tx, &rx)) {
+		printf("LEMON RPM: invalid GLINK layout; no power requests\n");
+		return;
+	}
+	bool tx_ok = lr_snapshot_pipe(base, "ap2r", tx);
+	bool rx_ok = lr_snapshot_pipe(base, "r2ap", rx);
+	printf("LEMON RPM: snapshot valid=%u; channel not opened, no rail or FIFO writes\n",
+	    tx_ok && rx_ok);
+}
+#endif
