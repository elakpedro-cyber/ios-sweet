+static bool
+lr_request(struct lr_link *link, uint32_t resource, uint32_t key, unsigned value)
+{
+	/* GLINK TX_DATA + chunk/left, then40-byte RPM request and one KVP. */
+	uint32_t packet[14] = {9u | (1u << 16), 0, 40, 0,
+	    0x00716572u, 32, ++link->request_id, 0, resource, 0, 12, key, 4, value};
+	link->reply_done = link->reply_ok = false;
+	link->waiting = true;
+	printf("LEMON RPM POWER: request=%u resource=%#x key=%#x value=%u\n",
+	    link->request_id, resource, key, value);
+	if (!lr_tx(link, packet, sizeof(packet))) { link->waiting = false; return false; }
+	for (unsigned i = 0; i < LR_OPEN_POLLS; i++) {
+		if (lr_receive(link) < 0) break;
+		if (link->reply_done) break;
+		delay(100);
+	}
+	link->waiting = false;
+	printf("LEMON RPM POWER: request=%u done=%u accepted=%u\n",
+	    link->request_id, link->reply_done, link->reply_ok);
+	return link->reply_done && link->reply_ok;
+}
+
+bool
+lemon_rpm_prepare_power(void)
+{
+	struct lr_link link = {0};
+	link.base = ml_io_map(LR_PA, LR_SIZE);
+	if (!link.base || !lr_parse(link.base, &link.tx, &link.rx)) return false;
+	link.mbox = ml_io_map(LR_MBOX_PA, 0x1000);
+	if (!link.mbox || !lr_handshake(&link)) return false;
+	/* Keep normal inherited vlvl keys unchanged. Raise ACTIVE floor keys, then
+	 * enable; never send a disable/unvote after partial GPU power-up. These
+	 * are RPM corner enums, NOT microvolts: CX SVS128, MX NOM256. */
+	if (!lr_request(&link, 0x786d7772u, 0x006c6676u, 256) ||
+	    !lr_request(&link, 0x78637772u, 0x006c6676u, 128) ||
+	    !lr_request(&link, 0x786d7772u, 0x6e657773u, 1) ||
+	    !lr_request(&link, 0x78637772u, 0x6e657773u, 1)) return false;
+	printf("LEMON RPM POWER: all4 ACTIVE floor/enable requests accepted\n");
+	return true;
+}
