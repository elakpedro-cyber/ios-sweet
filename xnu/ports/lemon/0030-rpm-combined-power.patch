 static bool
+lr_tx(struct lr_link *link, const uint32_t *packet, unsigned length)
+{
+	unsigned tail, head;
+	if (!length || (length & 7) || length > 256) return false;
+	if (!lr_indices(link->base, link->tx, &tail, &head)) {
+		printf("LEMON RPM OPEN: invalid TX indices\n");
+		return false;
+	}
+	unsigned used = head >= tail ? head - tail : link->tx.size - tail + head;
+	if (link->tx.size - used < length + 8) {
+		printf("LEMON RPM OPEN: TX full cmd=%u used=%u size=%u\n", packet[0] & 0xffff, used, link->tx.size);
+		return false;
+	}
+	for (unsigned i = 0; i < length; i += 4) {
+		lr_write(link->base, link->tx.offset + 8 + (head + i) % link->tx.size,
+		    packet[i / 4]);
+	}
+	lr_write(link->base, link->tx.offset + 4, (head + length) % link->tx.size);
+	/* SM6115 APCS mailbox channel0: IPC register +8, write BIT(0). */
+	lr_write(link->mbox, 8, 1);
+	return true;
+}
