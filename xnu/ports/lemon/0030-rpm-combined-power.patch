 /* Return -1 on invalid/unsupported input, 0 when waiting, 1 after consumption. */
+static bool
+lr_ack(struct lr_link *link, const uint32_t *data, unsigned size)
+{
+	if (size < 20 || (size & 3) || data[0] != 0x00716572u || data[1] != size - 8) return false;
+	bool found = false, error = false;
+	for (unsigned offset = 8; offset < size;) {
+		if (size - offset < 8) return false;
+		uint32_t key = data[offset / 4], length = data[offset / 4 + 1];
+		if (length > size - offset - 8) return false;
+		if (key == 0x2367736du) {
+			if (found || length != 4 || data[offset / 4 + 2] != link->request_id) return false;
+			found = true;
+		} else if (key == 0x00727265u) error = true;
+		else return false;
+		unsigned span = (length + 3) & ~3u;
+		if (span > size - offset - 8) return false;
+		offset += 8 + span;
+	}
+	return found && !error;
+}
