+
+static bool
+lm_capture(vm_offset_t base, uint32_t id0, struct lm_context *c)
+{
+	c->cba2r = lm_read(base, 0x1800);
+	c->cbar = lm_read(base, 0x1000);
+	c->sctlr = lm_read(base, LM_CB);
+	c->fsr = lm_read(base, LM_CB + 0x58);
+	if ((c->sctlr & 1) || c->fsr || (c->cba2r & ~1u) || (c->cbar & 0xffu)) return false;
+	/* TYPE0 without S2 support is an unconfigured bank, not a valid S1
+	 * snapshot. TTBR1/TCR2/CONTEXTIDR/MAIR are undefined in this format. */
+	c->reset = !c->cbar && !c->cba2r && !(id0 & (1u << 29));
+	if (c->reset) return true;
+	if ((c->cbar & 0x30000u) != 0x10000u) return false;
+	for (unsigned i = 0; i < 5; i++) c->regs[i] = lm_read(base, lm_offsets[i + 2]);
+	c->wide = (c->cba2r & 1) || (c->regs[1] & (1u << 31));
+	for (unsigned i = 0; i < 2; i++) {
+		unsigned offset = LM_CB + 0x20 + i * 8;
+		c->ttbr[i] = c->wide ? lm_read64(base, offset) : lm_read(base, offset);
+	}
+	return true;
+}
+
+static bool
+lm_same(const struct lm_context *a, const struct lm_context *b)
+{
+	if (a->cba2r != b->cba2r || a->cbar != b->cbar || a->sctlr != b->sctlr ||
+	    a->fsr != b->fsr || a->reset != b->reset || a->wide != b->wide) return false;
+	for (unsigned i = 0; i < 5; i++) if (a->regs[i] != b->regs[i]) return false;
+	return a->ttbr[0] == b->ttbr[0] && a->ttbr[1] == b->ttbr[1];
+}
+
+static bool
+lm_restore(vm_offset_t base, const struct lm_context *c, unsigned dirty)
+{
+	/* Do not restore table words under the test format. A rejected format
+	 * or control restoration stops before any format-dependent table write. */
+	for (unsigned i = 0; i < 4; i++) {
+		uint32_t value = i == 0 ? c->cba2r : i == 1 ? c->cbar : c->regs[i - 2];
+		if ((dirty & (1u << i)) && !lm_set(base, lm_offsets[i], value)) return false;
+	}
+	for (unsigned i = 4; i < 7; i++)
+		if ((dirty & (1u << i)) && !lm_set(base, lm_offsets[i], c->regs[i - 2])) return false;
+	for (unsigned i = 0; i < 2; i++) {
+		if (!(dirty & (1u << (7 + i)))) continue;
+		unsigned offset = LM_CB + 0x20 + i * 8;
+		bool ok = c->wide ? lm_set64(base, offset, c->ttbr[i]) : lm_set(base, offset, (uint32_t)c->ttbr[i]);
+		if (!ok) return false;
+	}
+	return true;
 }
 
