 	if (!lc_submit()) goto done;
+	lc.checkpoints|=8;
 	step="MEM_WRITE";
 	lc_put(lc_pkt7(0x10,1)); lc_put(0);
 	lc_put(lc_pkt4(LC_CP_SCRATCH)); lc_put(LC_SCRATCH);
@@ -447,7 +467,9 @@
 	__asm__ volatile("dsb sy" ::: "memory");
 	lc.executed=completed && *(volatile uint32_t *)(lc.memory+LC_TARGET)==LC_MARKER &&
