--- a/bsd/dev/lemon_gpu_cp.c
+++ b/bsd/dev/lemon_gpu_cp.c
@@ -26,7 +26,10 @@
 #define LC_MARKER 0x600df00du
 #define LC_SCRATCH 0xcafe6101u
 #define LC_CB 0x8000u
-#define LC_FAULT 0xc00001feu
+/* ASIDPNE=0: no private-ASID hint, explicit CB-local TLB maintenance.
+ * Keep bit12 in the comparison mask: do not accept arbitrary normalization. */
+#define LC_SCTLR 0x0127u
+#define LC_SCTLR_MASK 0x11f7u
 #define LC_SMR 0x80010000u /* user SID0/1, never SID2 (secure). */
 
 enum {
@@ -41,7 +44,7 @@
 static struct {
 	vm_offset_t gpu, smmu, memory;
 	uint64_t pa;
-	uint32_t old_smr, old_s2cr, wptr;
+	uint32_t old_smr, old_s2cr, wptr, checkpoints;
 	int slot;
