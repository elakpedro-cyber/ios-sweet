+/* Diagnostics only: never modify decoded contacts or the release deadline. */
+static struct {
+	int enabled;
+	uint64_t start, last, gap, read;
+	unsigned polls, valid, contacts, up, checksum, invalid, recovery, zero;
+} lt_perf;
+
+static void
+lt_perf_record(const uint8_t report[66], int error, unsigned mask,
+    uint64_t begin, uint64_t end)
+{
+	if (!lt_perf.enabled) return;
+	if (!lt_perf.start) lt_perf.start = begin;
+	if (lt_perf.last && begin - lt_perf.last > lt_perf.gap) lt_perf.gap = begin - lt_perf.last;
+	lt_perf.last = begin;
+	if (end - begin > lt_perf.read) lt_perf.read = end - begin;
+	lt_perf.polls++;
+	uint8_t sum = 0, bits = 0;
+	for (unsigned i = 1; i < 66; i++) { sum += report[i]; bits |= report[i]; }
+	if (!bits) lt_perf.zero++;
+	if (!error) {
+		lt_perf.valid++;
+		if (mask) lt_perf.contacts++;
+		else lt_perf.up++;
+	} else {
+		if (error == EAGAIN) lt_perf.recovery++;
+		else if (sum) lt_perf.checksum++;
+		else lt_perf.invalid++;
+	}
+	uint64_t elapsed, gap, read;
+	absolutetime_to_nanoseconds(end - lt_perf.start, &elapsed);
+	if (elapsed < 5000000000ULL) return;
+	absolutetime_to_nanoseconds(lt_perf.gap, &gap);
+	absolutetime_to_nanoseconds(lt_perf.read, &read);
+	printf("LEMON TOUCH PERF: ms=%llu polls=%u valid=%u contact=%u up=%u checksum=%u invalid=%u recovery=%u zero=%u gap_ms=%llu read_us=%llu\n",
+	    (unsigned long long)(elapsed / 1000000), lt_perf.polls, lt_perf.valid,
+	    lt_perf.contacts, lt_perf.up, lt_perf.checksum, lt_perf.invalid,
+	    lt_perf.recovery, lt_perf.zero, (unsigned long long)(gap / 1000000),
+	    (unsigned long long)(read / 1000));
+	lt_perf.start = end;
+	lt_perf.gap = lt_perf.read = 0;
+	lt_perf.polls = lt_perf.valid = lt_perf.contacts = lt_perf.up = 0;
+	lt_perf.checksum = lt_perf.invalid = lt_perf.recovery = lt_perf.zero = 0;
+}
+
