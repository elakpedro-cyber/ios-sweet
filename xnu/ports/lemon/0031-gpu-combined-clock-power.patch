+++ b/bsd/dev/lemon_gpu_power.c
@@ -0,0 +1,162 @@
+/* SM6115 cold GPU power/clock checkpoint after acknowledged RPM floor votes.
+ * Linux gpucc-sm6115.c/gcc-sm6115.c/gdsc.c/clk-alpha-pll.c/clk-rcg2.c.
+ * No GPU core/SMMU/DMA/firmware access; no shared PLL retuning or sleep votes.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET) && defined(LEMON_4K)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void lemon_gpu_power_probe(void);
+
+static uint32_t
+lp_read(vm_offset_t base, unsigned offset)
+{
+	uint32_t value = *(volatile uint32_t *)(base + offset);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+static void
+lp_write(vm_offset_t base, unsigned offset, uint32_t value)
+{
+	*(volatile uint32_t *)(base + offset) = value;
+	__asm__ volatile("dsb oshst" ::: "memory");
+}
+
+static void
+lp_update(vm_offset_t base, unsigned offset, uint32_t mask, uint32_t value)
+{
+	lp_write(base, offset, (lp_read(base, offset) & ~mask) | (value & mask));
+}
+
+static bool
+lp_wait(vm_offset_t base, unsigned offset, uint32_t mask, uint32_t value, unsigned count)
+{
+	for (unsigned i = 0; i < count; i++) {
+		if ((lp_read(base, offset) & mask) == value) return true;
+		delay(1);
+	}
+	printf("LEMON GPU POWER: timeout reg=%#x value=%#x mask=%#x wanted=%#x\n",
+	    offset, lp_read(base, offset), mask, value);
+	return false;
+}
+
+static bool
+lp_branch(vm_offset_t base, unsigned offset)
+{
+	lp_update(base, offset, 1, 1);
+	return lp_wait(base, offset, 0x80000001u, 1, 200);
+}
+
+static bool
+lp_pll640(vm_offset_t cc)
+{
+	uint32_t mode = lp_read(cc, 0x100), user = lp_read(cc, 0x110);
+	bool configured = lp_read(cc, 0x104) == 0x21 && lp_read(cc, 0x108) == 0x55555555 &&
+	    (lp_read(cc, 0x10c) & 0xff) == 0x55 && (user & 0x01338003u) == 0x01200003u;
+	printf("LEMON GPU POWER: pll1 mode=%#x user=%#x L=%#x alpha=%#x:%#x\n",
+	    mode, user, lp_read(cc, 0x104), lp_read(cc, 0x10c), lp_read(cc, 0x108));
+	if (mode & (1u << 20)) return false; /* No unknown FSM/voter ownership. */
+	if (mode & 7) {
+		/* Do not retune or reset a running/partially running PLL. */
+		return configured && (mode & 7) == 7 && (mode & (1u << 31));
+	}
+	lp_write(cc, 0x104, 0x21);
+	lp_write(cc, 0x108, 0x55555555);
+	lp_update(cc, 0x10c, 0xff, 0x55);
+	lp_write(cc, 0x118, 0x4001055b);
+	/* VCO2, alpha enabled, MAIN+AUX outputs, AUX post-divider1. */
+	lp_update(cc, 0x110, 0x01338003u, 0x01200003u);
+	if (lp_read(cc, 0x104) != 0x21 || lp_read(cc, 0x108) != 0x55555555 ||
+	    (lp_read(cc, 0x10c) & 0xff) != 0x55 ||
+	    (lp_read(cc, 0x110) & 0x01338003u) != 0x01200003u ||
+	    lp_read(cc, 0x118) != 0x4001055b) return false;
+	lp_update(cc, 0x100, 2, 2);
+	delay(5);
+	lp_update(cc, 0x100, 4, 4);
+	if (!lp_wait(cc, 0x100, 1u << 31, 1u << 31, 2000)) return false;
+	lp_update(cc, 0x100, 1, 1);
+	return lp_wait(cc, 0x100, 7, 7, 200);
+}
+
+static bool
+lp_rcg(vm_offset_t cc, unsigned command, unsigned config)
+{
+	/* Consumers are cold/disabled; parent PLL already verified and running. */
+	lp_update(cc, command + 4, 0x10371f, config);
+	lp_update(cc, command, 3, 3); /* Force root on while updating. */
+	if (!lp_wait(cc, command, 1, 0, 500)) return false;
+	if ((lp_read(cc, command + 4) & 0x10371f) != config) return false;
+	return lp_wait(cc, command, 1u << 31, 0, 200);
+}
+
+void
+lemon_gpu_power_probe(void)
+{
+	vm_offset_t gcc = ml_io_map(0x01400000, 0x80000);
+	if (!gcc || !(lp_read(gcc, 0x7900c) & 16) ||
+	    (lp_read(gcc, 0x36004) & 0x80000001u) != 1 ||
+	    (lp_read(gcc, 0x36040) & (1u << 31))) {
+		printf("LEMON GPU POWER: config access unavailable; stopped\n");
+		return;
+	}
+	vm_offset_t cc = ml_io_map(0x05990000, 0x9000);
+	if (!cc) return;
+	unsigned stage = 0;
+	printf("LEMON GPU POWER: begin cx=%#x cx_status=%#x gx=%#x\n",
+	    lp_read(cc, 0x106c), lp_read(cc, 0x1540), lp_read(cc, 0x100c));
+	/* Cold GX only. Refuse active hardware-controlled domains or consumers. */
+	if ((lp_read(cc, 0x106c) & 2) || (lp_read(cc, 0x100c) & 0x80000002u) ||
+	    (lp_read(cc, 0x1054) & 1) || (lp_read(cc, 0x10a4) & 1) ||
+	    (lp_read(cc, 0x1098) & 1)) goto out;
+	/* Shared GPLL0 is read-only. Accept only retained600MHz before /3 GMU. */
+	if (!(lp_read(gcc, 0) & (1u << 31)) || lp_read(gcc, 4) != 31 ||
+	    lp_read(gcc, 8) != 0 || (lp_read(gcc, 12) & 0xff) != 0x40 ||
+	    !(lp_read(gcc, 24) & (1u << 24))) {
+		printf("LEMON GPU POWER: shared GPLL0 not verified600MHz; no retuning\n");
+		goto out;
+	}
+	stage = 1;
+	lp_update(cc, 0x106c, 1, 0);
+	delay(1);
+	/* CX reports its real status via gds_hw_ctrl1540, not GDSCR106c. */
+	if (!lp_wait(cc, 0x1540, 1u << 31, 1u << 31, 2000)) goto out;
+	delay(1);
+	printf("LEMON GPU POWER: CX on\n");
+	stage = 2;
+	if (!lp_branch(cc, 0x1078) || !lp_branch(cc, 0x109c)) goto out;
+	/* Linux GX SW_RESET followed by clamp deassert and collapse clear. */
+	lp_update(cc, 0x1008, 1, 1);
+	if (!(lp_read(cc, 0x1008) & 1)) goto out;
+	delay(1);
+	lp_update(cc, 0x1008, 1, 0);
+	if (lp_read(cc, 0x1008) & 1) goto out;
+	lp_update(cc, 0x1508, 1, 0);
+	if (lp_read(cc, 0x1508) & 1) goto out;
+	lp_update(cc, 0x100c, 1, 0);
+	if (!lp_wait(cc, 0x100c, 1u << 31, 1u << 31, 2000)) goto out;
+	delay(1);
+	printf("LEMON GPU POWER: GX on\n");
+	stage = 3;
+	if (!lp_branch(cc, 0x1060) || !lp_pll640(cc)) goto out;
+	lp_update(gcc, 0x79004, 1u << 15, 1u << 15);
+	delay(10);
+	if (!(lp_read(gcc, 0x79004) & (1u << 15))) goto out;
+	if (!lp_rcg(cc, 0x101c, 0x303) || !lp_rcg(cc, 0x1120, 0x505)) goto out;
+	stage = 4;
+	if (!lp_branch(gcc, 0x71154) || !lp_branch(gcc, 0x3600c) ||
+	    !lp_branch(gcc, 0x36018) || !lp_branch(cc, 0x108c) ||
+	    !lp_branch(cc, 0x1098) || !lp_branch(cc, 0x10a4) || !lp_branch(cc, 0x1054)) goto out;
+	lp_update(cc, 0x101c, 2, 0);
+	lp_update(cc, 0x1120, 2, 0);
+	stage = 5;
+	printf("LEMON GPU POWER: ready core320MHz GMU200MHz configuration; no GPU commands\n");
+out:
+	printf("LEMON GPU POWER: end stage=%u cx_status=%#x gx=%#x gfx=%#x gmu=%#x\n",
+	    stage, lp_read(cc, 0x1540), lp_read(cc, 0x100c), lp_read(cc, 0x1054), lp_read(cc, 0x1098));
+	/* Retain acknowledged rail floors and reached state on stop. Never unvote
+	 * beneath a possibly powered domain; reboot to recovery ends this test. */
+}
+#endif
