+
+void
+AppleCLCD::perfSample(uint64_t presentTicks, bool presented)
+{
+	if (!fStats) return;
+	uint64_t now = mach_absolute_time(), elapsedNS, presentNS;
+	fPerfVsyncs++;
+	fPerfFrames += presented ? 1 : 0;
+	fPerfPresent += presentTicks;
+	absolutetime_to_nanoseconds(now - fPerfStart, &elapsedNS);
+	if (elapsedNS < 5000000000ULL) return;
+	absolutetime_to_nanoseconds(fPerfPresent, &presentNS);
+	IOLog("LEMON PERF: vsyncs=%llu frames=%llu elapsed_ms=%llu present_ms=%llu\n",
+	    (unsigned long long)fPerfVsyncs, (unsigned long long)fPerfFrames,
+	    (unsigned long long)(elapsedNS / 1000000), (unsigned long long)(presentNS / 1000000));
+	fPerfStart = now;
+	fPerfVsyncs = fPerfFrames = fPerfPresent = 0;
 }
 
