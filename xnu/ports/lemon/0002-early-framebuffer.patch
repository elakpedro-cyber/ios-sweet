+/* Early 4K framebuffer mappings. Inputs x6=VA, x7=PA, x8=end VA.
+ * root/cursor/limit must not alias x0 or x6-x16. Cursor points at the last
+ * allocated page, as in XNU create_bootstrap_mapping. Clobbers x0,x6-x16.
+ */
+#ifndef LEMON_FB_MAP_H
+#define LEMON_FB_MAP_H
+#define LEMON_FB_BASE 0x5c000000
+#define LEMON_FB_WIDTH 1080
+#define LEMON_FB_HEIGHT 2340
+#define LEMON_FB_STRIDE 4320
+#define LEMON_FB_BYTES (LEMON_FB_HEIGHT * LEMON_FB_STRIDE)
+#define LEMON_FB_MAP_BYTES ((LEMON_FB_BYTES + 0x1fffff) & ~0x1fffff)
+#define LEMON_BOOTSTRAP_PAGES 34
+/* Valid L2 block, Normal-NC (MAIR[1]), outer-shareable, AF, PXN, UXN. */
+#define LEMON_FB_BLOCK_FLAGS 0x0060000000000605
+
+#ifdef ASSEMBLER
+.macro lemon_map_fb root, cursor, limit, fail
+1:
+    ubfx x9, x6, #30, #9
+    add x9, \root, x9, lsl #3
+    ldr x10, [x9]
+    cbnz x10, 3f
+    add x12, \cursor, #4096
+    add x0, x12, #4096
+    cmp x0, \limit
+    b.hi \fail
+    mov x13, x12
+    mov x14, #256
+2:
+    stp xzr, xzr, [x13], #16
+    subs x14, x14, #1
+    b.ne 2b
+    orr x10, x12, #3
+    str x10, [x9]
+    mov \cursor, x12
+3:
+    and x0, x10, #3
+    cmp x0, #3
+    b.ne \fail
+    and x11, x10, #0x0000fffffffff000
+    ubfx x14, x6, #21, #9
+    add x11, x11, x14, lsl #3
+    movz x15, #0x605
+    movk x15, #0x60, lsl #48
+    orr x16, x7, x15
+    ldr x10, [x11]
+    cbz x10, 4f
+    cmp x10, x16
+    b.ne \fail
+4:
+    str x16, [x11]
+    add x6, x6, #0x200000
+    add x7, x7, #0x200000
+    cmp x6, x8
+    b.lo 1b
+    dsb ishst
+.endm
+#endif
+#endif
