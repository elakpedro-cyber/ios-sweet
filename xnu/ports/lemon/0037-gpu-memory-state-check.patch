+static bool
+lm_state(vm_offset_t base, const struct lm_context *c, const char *phase, bool allow_fsr)
+{
+	uint32_t sctlr = lm_read(base, LM_CB), fsr = lm_read(base, LM_CB + 0x58);
+	uint32_t gfsr = lm_read(base, 0x48);
+	/* TYPE0 -> Stage1 changes the meaning of non-M SCTLR fields. This is
+	 * only a disabled-context preparation; do not compare those fields as
+	 * though the original unsupported Stage2 format were still in effect.
+	 * A supported original Stage1 context retains the exact-state contract. */
+	bool control = c->reset ? !(sctlr & 1) : sctlr == c->sctlr;
+	printf("LEMON GPU MEMORY: state=%s initial_sctlr=%#x sctlr=%#x fsr=%#x gfsr=%#x cbar=%#x cba2r=%#x reset=%u control_ok=%u\n",
+	    phase,c->sctlr,sctlr,fsr,gfsr,lm_read(base,0x1000),lm_read(base,0x1800),c->reset,control);
+	return control && !gfsr && (allow_fsr || !fsr);
 }
 
