+/* Metadata fallback: require two checksummed frames showing real movement. */
+static bool
+lt_live_motion(unsigned mask, const int x[10], const int y[10],
+    unsigned *previous, int px[10], int py[10])
+{
+	bool moved = false;
+	if (mask && mask == *previous) {
+		for (unsigned i = 0; i < 10; i++) {
+			if ((mask & (1u << i)) && (x[i] != px[i] || y[i] != py[i])) {
+				moved = true;
+			}
+		}
+	}
+	*previous = mask;
+	memcpy(px, x, 10 * sizeof(int));
+	memcpy(py, y, 10 * sizeof(int));
+	return moved;
 }
 
